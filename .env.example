# SQLite file. Prisma resolves this from the schema folder (prisma/), so ../data lands in the project data directory.
DATABASE_URL="file:../data/app.db"

# Signs the login cookie. Use a long random string in production.
SESSION_SECRET="replace-with-a-long-random-string"

# Public URL of this app. Used in WhatsApp links, magic links, and Stripe return URLs.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"

# Protects POST /api/cron/weekly. The weekly script also runs locally via npm run job:weekly.
CRON_SECRET="replace-with-a-long-random-string"

# Photos on a birthday comic are deleted after the book is drawn.
# Set to "false" only if you intentionally need to keep them for a retry window.
PHOTO_DELETE_AFTER_GENERATION="true"

# Story writing. Leave blank to use the built-in storyteller (no network call).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Voice cloning and narration. Leave blank to store the recording and speak with a local preview voice.
ELEVENLABS_API_KEY=""
ELEVENLABS_STOCK_VOICE_ID=""

# Comic art. Leave the key blank to use the bundled sample picture book.
# A photo is the reference for one character sheet. That sheet is the reference for every panel.
# openai (default): gpt-image edits. IMAGE_MODEL can be gpt-image-1. dall-e cannot take a reference, so a photo still uses gpt-image-1.
# replicate: InstantID, PhotoMaker, or IP-Adapter. IMAGE_MODEL is owner/name, for example zsxkib/instant-id.
# fal: IMAGE_API_BASE_URL is the model URL, for example https://fal.run/fal-ai/instantid
IMAGE_API_KEY=""
IMAGE_PROVIDER=""
IMAGE_API_BASE_URL="https://api.openai.com/v1"
IMAGE_MODEL="gpt-image-1"

# Payments. Leave blank to use the in-app practice checkout (no card is charged).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional. Headless Chrome used to print the comic PDF. Defaults to google-chrome on PATH.
CHROME_PATH=""
